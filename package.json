{
  "name": "loadless",
  "version": "4.4.0",
  "private": true,
  "description": "Loadless — Gérez votre foyer en équité",
  "scripts": {
    "cap:init": "npx cap init LoadLess fr.loadless.app --web-dir .",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "build:apk": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/core": "^5.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.0"
  }
}
